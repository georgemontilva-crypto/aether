# ── Obligatorias ─────────────────────────────────────────────
# MySQL (en Railway: referencia a la variable del servicio MySQL → ${{MySQL.MYSQL_URL}})
DATABASE_URL=mysql://usuario:clave@host:3306/aether
# Clave para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Texto largo y aleatorio para firmar la sesión del panel
JWT_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# ── Fotos en Cloudflare R2 (necesarias para subir fotos desde el panel) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (dominio propio o https://pub-xxxx.r2.dev), sin "/" al final
R2_PUBLIC_URL=

# ── Opcionales ───────────────────────────────────────────────
# URL pública del sitio (para el enlace del pedido en el mensaje de WhatsApp)
PUBLIC_URL=
# Solo desarrollo local: carpeta donde guardar fotos si no hay R2
UPLOAD_DIR=
PORT=3000
